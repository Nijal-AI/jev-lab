# Copiez ce fichier en .env, puis lancez : uv run --env-file .env python run.py
# Sans clé, le fournisseur concerné passe en mode simulé (badge rouge « SIMULÉ »).

# Jev (TypeSafe AI) — https://docs.typesafe.ai
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# LLM compatible OpenAI pour le duel (par défaut : API Mistral)
LLM_API_KEY=
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest
# Prix en dollars par million de tokens, pour le coût affiché
LLM_PRICE_IN=0.1
LLM_PRICE_OUT=0.3

# Accès à l'atelier
SESSION_CODES=atelier
ADMIN_CODE=
# Chaîne aléatoire longue : sans elle, tout le monde est déconnecté à chaque redémarrage
SECRET_KEY=
MAX_CALLS_PER_PARTICIPANT=400
